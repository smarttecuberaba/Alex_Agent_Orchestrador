# Supabase — projeto betaAgente
SUPABASE_URL=https://vyxdquwxmgibpkoswxut.supabase.co
SUPABASE_KEY=sua_service_role_key_aqui

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Chatwoot (interface WhatsApp via Baileys)
CHATWOOT_URL=https://chatwoot.smarttecsolutions.com.br
CHATWOOT_API_TOKEN=seu_api_access_token_aqui
CHATWOOT_ACCOUNT_ID=1

# Webhook — segredo adicionado na URL do webhook no Chatwoot
# Ex: https://agente.2wpneus.com.br/webhook?secret=ESTE_VALOR
WEBHOOK_SECRET=troque_por_uma_string_aleatoria_longa

# Servidor
PORT=8000
LOG_LEVEL=info
